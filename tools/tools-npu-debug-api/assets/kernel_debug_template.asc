// SIMD example below; this file is not a complete runnable project.
// Copy only the observations needed for the target mode.
// Caller must supply a valid allocation and its actual element count.
// Keep the computation under test unchanged.
#include "kernel_operator.h"
#include "utils/debug/asc_assert.h"
#include "utils/debug/asc_dump.h"
#include "utils/debug/asc_printf.h"
#include "utils/debug/asc_time.h"

__global__ __aicore__ void KernelDebugTemplate(__gm__ half *input, uint32_t inputCount)
{
    uint32_t block = AscendC::GetBlockIdx();
    if (block == 0) {
        AscendC::printf("block=%u\n", block);
        ascendc_assert(input != nullptr, "input is null\n");
        // Assertions can be disabled; guard the access independently.
        if (input != nullptr && inputCount > 0) {
            uint32_t dumpCount = inputCount < 16 ? inputCount : 16;
            asc_dump_gm<half>(input, 0x10001, dumpCount);
        }

        uint64_t start = clock();
        // Replace this empty region with the code to measure.
        // The empty-region cycle count is not an operator performance result.
        uint64_t end = clock();
        AscendC::printf("cycles=%llu\n", end - start);

        // Enable with -DASCENDC_TIME_STAMP_ON when the target mode supports it.
        asc_time_stamp(0x10002);
    }
}

// Optional SIMT VF snippet: opt in only after checking target platform support.
// This macro selects the example; it does not enable hardware support.
#ifdef KERNEL_DEBUG_ENABLE_SIMT_TRAP_EXAMPLE
__simt_vf__ __launch_bounds__(1024) inline void TrapOnInvalid(__gm__ float *x, uint32_t elementCount)
{
    // This snippet inspects a single block-sized slice supplied by the caller.
    uint32_t index = threadIdx.x;
    if (x != nullptr && index < elementCount && isnan(x[index])) {
        __trap();
    }
}
#endif // KERNEL_DEBUG_ENABLE_SIMT_TRAP_EXAMPLE
