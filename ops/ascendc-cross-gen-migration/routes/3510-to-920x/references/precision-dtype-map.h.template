#ifndef MIGRATION_PRECISION_DTYPE_MAP_H
#define MIGRATION_PRECISION_DTYPE_MAP_H

// Include after AT_ALL_SCALAR_TYPE_AND_ACL_DATATYPE_PAIR in the generated helper.
// Confirm the FP8 enum names in the actual PyTorch and CANN headers before use.
inline aclDataType MigrationAclDataType(at::ScalarType scalarType)
{
    aclDataType result = ACL_DT_UNDEFINED;
    switch (scalarType) {
#define MIGRATION_DTYPE_CASE(torchType, aclType) case torchType: result = aclType; break;
        AT_ALL_SCALAR_TYPE_AND_ACL_DATATYPE_PAIR(MIGRATION_DTYPE_CASE)
#undef MIGRATION_DTYPE_CASE
        case at::ScalarType::Float8_e5m2:
            result = ACL_FLOAT8_E5M2;
            break;
        case at::ScalarType::Float8_e4m3fn:
            result = ACL_FLOAT8_E4M3FN;
            break;
        default:
            break;
    }
    TORCH_CHECK(result != ACL_DT_UNDEFINED, "Unsupported scalar dtype in migration binding: ", scalarType);
    return result;
}

#endif
