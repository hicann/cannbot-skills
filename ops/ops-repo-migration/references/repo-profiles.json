{
  "schema_version": 1,
  "repositories": {
    "ops-math": {
      "url": "https://gitcode.com/cann/ops-math.git",
      "classes": ["math", "conversion", "random"],
      "layout_reference": "target-layout-ops-math.md",
      "vendor_suffix": "_math",
      "package_glob": "cann-ops-math-{vendor}_linux-*.run",
      "package_cmake": "cmake/package.cmake",
      "kernel_entry_suffixes": ["", "_apt", "_910b"],
      "cmake_file": "CMakeLists.txt",
      "cmake_macro": "add_all_modules_sources",
      "explicit_tests": false,
      "tiling_lists": true,
      "ut_arch_source": "tiling_list",
      "tiling_arch_glob": "test_*_tiling*.cpp",
      "infershape_in_arch": false,
      "example_dirs": {"default": ["**"]},
      "soc_arch": {}
    },
    "ops-nn": {
      "url": "https://gitcode.com/cann/ops-nn.git",
      "classes": ["matmul", "conv", "activation", "foreach", "hash", "vfusion", "index", "loss", "norm", "optim", "pooling", "quant", "rnn", "control"],
      "layout_reference": "target-layout-ops-nn.md",
      "vendor_suffix": "_nn",
      "package_glob": "cann-ops-nn-{vendor}_linux-*.run",
      "package_cmake": "cmake/variables.cmake",
      "kernel_entry_suffixes": ["", "_apt", "_910b"],
      "cmake_file": "CMakeLists.txt",
      "cmake_macro": "add_all_modules_sources",
      "explicit_tests": false,
      "tiling_lists": true,
      "ut_arch_source": "soc",
      "tiling_arch_glob": "test_*_tiling.cpp",
      "infershape_in_arch": true,
      "example_dirs": {"default": [""], "ascend910b": ["", "arch22"], "ascend310p": ["", "arch20"], "ascend950": ["", "arch35"], "ascend350": ["", "arch35"], "ascend960dt": ["", "arch35"], "ascend960pr": ["", "arch35"]},
      "soc_arch": {"ascend910b": "arch22", "ascend910_93": "arch22", "ascend310p": "arch22", "ascend950": "arch35", "ascend350": "arch35", "mc62": "arch35", "ascend960dt": "arch35", "ascend960pr": "arch35"}
    },
    "ops-cv": {
      "url": "https://gitcode.com/cann/ops-cv.git",
      "classes": ["image", "objdetect"],
      "layout_reference": "target-layout-ops-cv.md",
      "vendor_suffix": "_cv",
      "package_glob": "cann-ops-cv-{vendor}-linux.*.run",
      "package_cmake": "cmake/package.cmake",
      "kernel_entry_suffixes": ["", "_apt", "_910b"],
      "cmake_file": "CMakeLists.txt",
      "cmake_macro": "add_all_modules_sources",
      "explicit_tests": true,
      "tiling_lists": true,
      "ut_arch_source": "tiling_list",
      "tiling_arch_glob": "test_*_tiling.cpp",
      "infershape_in_arch": false,
      "example_dirs": {"default": [""], "ascend950": ["", "arch35"], "ascend350": ["", "arch35"], "mc62": ["", "arch35"]},
      "soc_arch": {}
    },
    "ops-transformer": {
      "url": "https://gitcode.com/cann/ops-transformer.git",
      "classes": ["attention", "ffn", "gmm", "mamba", "mc2", "mhc", "moe", "posembedding"],
      "layout_reference": "target-layout-ops-transformer.md",
      "vendor_suffix": "_transformer",
      "package_glob": "cann-ops-transformer-{vendor}_linux-*.run",
      "package_cmake": "cmake/custom_build.cmake",
      "kernel_entry_suffixes": ["", "_apt", "_a2", "_a3"],
      "cmake_file": "op_host/CMakeLists.txt",
      "cmake_macro": "add_modules_sources_with_soc",
      "explicit_tests": true,
      "tiling_lists": false,
      "ut_arch_source": "soc",
      "tiling_arch_glob": "test_*_tiling.cpp",
      "infershape_in_arch": true,
      "example_dirs": {"default": [""], "ascend950": ["", "arch35"]},
      "soc_arch": {"ascend310p": "arch20", "ascend910b": "arch22", "ascend910_93": "arch22", "ascend950": "arch35", "ascend960dt": "arch35", "ascend350": "arch35", "mc62": "arch38", "kirinx90": "arch22", "kirin9030": "arch22", "ascend5162a": "arch35"}
    }
  }
}
