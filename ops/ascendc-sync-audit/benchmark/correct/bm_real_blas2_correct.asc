// LABEL: correct
// SYNC: NONE
// DESC: WaitVecToScalar 用 V_S 同步把 Vector 结果交给标量读取，方向与数据流匹配
// SOURCE: ops-blas/blas/rotm/arch22/srotm_kernel.cpp
// ORIG_LINE: 210-224

template <typename T>
__aicore__ inline void SrotmKernel<T>::WaitScalarToVec()
{
    event_t eventID = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::S_V));
    SetFlag<HardEvent::S_V>(eventID);
    WaitFlag<HardEvent::S_V>(eventID);
}

template <typename T>
__aicore__ inline void SrotmKernel<T>::WaitVecToScalar()
{
    event_t eventID = static_cast<event_t>(GetTPipePtr()->FetchEventID(HardEvent::V_S));
    SetFlag<HardEvent::V_S>(eventID);
    WaitFlag<HardEvent::V_S>(eventID);
}
