// LABEL: defect
// SYNC: SYNC-03
// DESC: 单核残留 CrossCoreWaitFlag 无 Set
#include "kernel_operator.h"
using namespace AscendC;

constexpr int32_t EVENT_ID0 = 0;
constexpr int32_t EVENT_ID1 = 1;
constexpr int32_t EVENT_ID2 = 2;

constexpr int32_t SYNC_AIC_AIV = 0;

class KernelTest {
public:
    __aicore__ inline KernelTest() {}
    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t tileSize) {
        xGm.SetGlobalBuffer((__gm__ half *)x, totalLength);
        yGm.SetGlobalBuffer((__gm__ half *)y, totalLength);
        pipe.InitBuffer(inQueueX, 2, tileSize * sizeof(half));
        pipe.InitBuffer(outQueueY, 2, tileSize * sizeof(half));
        this->tileSize = tileSize;
        this->totalLength = totalLength;
    }
    __aicore__ inline void Process() {
        // 单核场景残留 CrossCoreWaitFlag，无人 SetFlag → 死等
        CrossCoreWaitFlag<HardEvent::MTE2_V>(SYNC_AIC_AIV);
        Adds(yLocal, xLocal, 1.0f, tileSize);
    }
private:
    TPipe pipe;
    TQue<QuePosition::VECIN, 2> inQueueX;
    TQue<QuePosition::VECOUT, 2> outQueueY;
    TBuf<TPosition::VECCALC> tmpBuf;
    GlobalTensor<half> xGm, yGm, wsGm;
    LocalTensor<half> xLocal, yLocal, midLocal, buf0, buf1;
    DataCopyExtParams copyParams;
    DataCopyPadExtParams<half> padParams;
    uint32_t tileSize, totalLength, count;
};
