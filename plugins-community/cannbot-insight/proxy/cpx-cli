# cpx-cli — wrapper so users don't need an alias. Resolves its own location
# (cwd-agnostic) and delegates to tsx + the real cpx-cli.ts. Works from any dir;
# run `proxy/start.sh` once to put `cpx` on PATH.
set -e
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
TSX=""
for d in "$SCRIPT_DIR" "$SCRIPT_DIR/.." "$SCRIPT_DIR/../.."; do
  [ -x "$d/node_modules/.bin/tsx" ] && TSX="$d/node_modules/.bin/tsx" && break
done
[ -n "$TSX" ] || TSX="npx --yes tsx"
exec $TSX "$SCRIPT_DIR/src/cli/cpx-cli.ts" "$@"
