# Inject only the neutral router; never provision a compiler before chip selection.
set -euo pipefail
hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
plugin_dir="$(cd "$hook_dir/.." && pwd)"
python3 - "$plugin_dir" <<'PYTHON'
import json
import os
from pathlib import Path
import re
import sys
root = Path(sys.argv[1]).resolve()
text = (root / 'AGENTS.md').read_text()
text = re.sub(r'^---\n.*?\n---\n', '', text, count=1, flags=re.S)
text = text.replace('(../../ops/', '(' + str(root.parent.parent / 'ops') + '/')
text = text.replace('(workflows/', '(' + str(root / 'workflows') + '/')
text = text.replace('(references/', '(' + str(root / 'references') + '/')
text = 'CANNBot TileLang: read the router and select one platform workflow.\n\n' + text
if os.environ.get('CLAUDE_PLUGIN_ROOT'):
    print(json.dumps({'hookSpecificOutput': {'hookEventName': 'SessionStart', 'additionalContext': text}}, ensure_ascii=False))
else:
    print(json.dumps({'additional_context': text}, ensure_ascii=False))
PYTHON
